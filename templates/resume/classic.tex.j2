\newcommand{\entry}[4]{%
  \vspace{1pt}\item[]%
  \begin{tabular*}{\textwidth}[t]{l@{\extracolsep{\fill}}r}
    \textbf{#1} & #2 \\
    \textit{\small#3} & \textit{\small #4} \\
  \end{tabular*}\vspace{-6pt}%
}
\newcommand{\bullets}{\begin{itemize}[leftmargin=0.15in,label={--},topsep=1pt,itemsep=\VAR{item_sep}pt,parsep=0pt]}
\newcommand{\bulletsend}{\end{itemize}\vspace{-4pt}}
\newcommand{\point}[1]{\item\small{#1 \vspace{-1pt}}}

