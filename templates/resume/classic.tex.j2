%% ---------------------------------------------------------------------------
%% ATS TEXT-LAYER CORRECTNESS. Do not remove any of these four lines.
%%
%% Without them pdflatex hyphen-splits words across line breaks in the extracted
%% text layer ("scaffolding" -> "scaf-" + "folding"). Parsers do not rejoin them,
%% so any keyword landing on a break becomes invisible to keyword search.
%% glyphtounicode makes ligatures and glyphs extract as real characters.
%% ---------------------------------------------------------------------------
\input{glyphtounicode}
\pdfgentounicode=1
\hyphenpenalty=10000
\exhyphenpenalty=10000
\sloppy
\raggedbottom
\raggedright
