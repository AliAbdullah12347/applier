# ---------------------------------------------------------------------------
# PERSONAL DATA -- never tracked.
# This repo is designed to be safe to make PUBLIC as a portfolio project.
# Everything identifying lives in files listed here and stays on your machine.
# (NOTE: git does not support trailing comments on a pattern line. Comments
#  must be on their own line, or the whole line becomes part of the pattern.)
# ---------------------------------------------------------------------------
config/profile.yaml
config/bank/claims.yaml
config/bank/master_resume.md
config/bank/atoms.yaml
PLAN.md
STATE.md
CLAUDE.md
private/
tools/

# secrets & credentials -- NEVER commit
.env
config/secrets.yaml

*.key
*.pem
.browser-profile/
.playwright/
token.json
credentials.json
*.session

# generated artifacts
data/board_tokens.json
# `data/*.db` alone is not enough. SQLite runs in WAL mode here, so the live
# data also sits in applier.db-wal and applier.db-shm -- and those matched
# nothing, so `git add -A` staged a file full of real job and application
# rows. Glob the sidecars too.
data/*.db
data/*.db-*
data/*.sqlite3
data/*.sqlite3-*
applications/
out/
*.aux
*.log
*.out
*.fls
*.synctex.gz

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# research working files (local only, not part of the product)
research/
_git_migration_backup/
tool-results/

# GUI-written settings overlay: one person's choices, not the shipped defaults
config/settings.local.yaml
.claude/launch.json
